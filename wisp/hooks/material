#!/bin/sh
# wisp-shell runs this with the island material (solid | tinted | smoked) at
# startup and whenever it changes in Settings > Shell. Windows follow the
# islands: kitty's glass and Hyprland's blur character match each material.
# Blur size/passes stay with Settings > Hyprland (general.lua).
set -eu

material="${1:-solid}"
config="${XDG_CONFIG_HOME:-$HOME/.config}"

# Fills follow core/Theme.qml's materials; kitty keeps text readable, so the
# glass ones are a little more opaque than the islands (0.72 / 0.90).
case "$material" in
    tinted)
        bg="#0c0d12" opacity="0.80" inactive="0.92"
        blur="vibrancy = 0.3, brightness = 1.0, contrast = 1.0, noise = 0.02" ;;
    smoked)
        bg="#0b0c0f" opacity="0.90" inactive="0.92"
        blur="vibrancy = 0.1, brightness = 0.8, contrast = 0.9, noise = 0.01" ;;
    *)
        material="solid"
        bg="#0a0b0e" opacity="1.0" inactive="1.0"
        blur="vibrancy = 0.1, brightness = 1.0, contrast = 1.0, noise = 0.01" ;;
esac

mkdir -p "$config/kitty" "$config/hypr"

cat > "$config/kitty/material.conf" <<KITTY
# Generated by ~/.config/wisp/hooks/material ($material) -- do not edit.
background $bg
background_opacity $opacity
KITTY

cat > "$config/hypr/material.lua" <<LUA
-- Generated by ~/.config/wisp/hooks/material ($material) -- do not edit.
hl.config({
    decoration = {
        inactive_opacity = $inactive,
        blur = { $blur }
    }
})
LUA

pkill -USR1 -x kitty 2>/dev/null || true
hyprctl reload >/dev/null 2>&1 || true
