{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "padding": {
            "top": 2,
            "right": 6,
            "left": 2
        },
        "color": {
            "1": "magenta"
        }
    },
    "display": {
        "separator": "  󰁔  ",
        "color": {
            "keys": "magenta"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "cyan",
                "at": "white",
                "host": "cyan"
            }
        },
        "break",
        {
            "type": "os",
            "key": "󰍹 OS  ",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "󰌢 Ker ",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "󰏖 Pkg ",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "󰨇 WM  ",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "󰆍 Sh  ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "󰆍 Term",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "󰅐 Up  ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰍛 Mem ",
            "keyColor": "green"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
