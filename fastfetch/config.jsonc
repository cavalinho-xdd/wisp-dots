{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "constants": [
            "\u001b[38;2;205;214;244m",
            "\u001b[38;2;203;166;247m"
        ]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭──────────────────────────────╮",
            "format": ""
        },
        {
            "type": "os",
            "key": "│ {$1}󰍹 OS  ",
            "format": "{$2}{name>20}{$1} │"
        },
        {
            "type": "kernel",
            "key": "│ {$1}󰌢 Ker ",
            "format": "{$2}{release>20}{$1} │"
        },
        {
            "type": "packages",
            "key": "│ {$1}󰏖 Pkg ",
            "format": "{$2}{all>20}{$1} │"
        },
        {
            "type": "wm",
            "key": "│ {$1}󰨇 WM  ",
            "format": "{$2}{2<12}{5<8}{$1} │"
        },
        {
            "type": "shell",
            "key": "│ {$1}󰆍 Sh  ",
            "format": "{$2}{3<12}{4<8}{$1} │"
        },
        {
            "type": "terminal",
            "key": "│ {$1}󰆍 Term",
            "format": "{$2}{3<20}{$1} │"
        },
        {
            "type": "uptime",
            "key": "│ {$1}󰅐 Up  ",
            "format": "{$2}{2>15}h {4}m{$1} │"
        },
        {
            "type": "memory",
            "key": "│ {$1}󰍛 Mem ",
            "format": "{$2}{1<9} /{2<9}{$1} │"
        },
        {
            "type": "custom",
            "key": "╰──────────────────────────────╯",
            "format": ""
        },
        "break"
    ]
}
