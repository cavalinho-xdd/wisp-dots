# Wisp Ember theme for btop generated by matugen
# Fixed neutrals; the ember (primary) marks highlights and the middle of every graph.
# Empty main_bg lets the kitty glass show through.
theme[main_bg]=""
theme[main_fg]="#eef0f4"
theme[title]="#eef0f4"
theme[hi_fg]="#{{colors.primary.default.hex_stripped}}"
theme[selected_bg]="#20232a"
theme[selected_fg]="#{{colors.primary.default.hex_stripped}}"
theme[inactive_fg]="#5c616c"
theme[graph_text]="#8a8f9b"
theme[meter_bg]="#15171c"
theme[proc_misc]="#{{colors.primary.default.hex_stripped}}"
theme[cpu_box]="#20232a"
theme[mem_box]="#20232a"
theme[net_box]="#20232a"
theme[proc_box]="#20232a"
theme[div_line]="#20232a"
theme[temp_start]="#5c616c"
theme[temp_mid]="#{{colors.primary.default.hex_stripped}}"
theme[temp_end]="#f38ba8"
theme[cpu_start]="#5c616c"
theme[cpu_mid]="#{{colors.primary.default.hex_stripped}}"
theme[cpu_end]="#f38ba8"
theme[free_start]="#5c616c"
theme[free_mid]="#{{colors.primary.default.hex_stripped}}"
theme[free_end]="#f38ba8"
theme[cached_start]="#5c616c"
theme[cached_mid]="#{{colors.primary.default.hex_stripped}}"
theme[cached_end]="#f38ba8"
theme[available_start]="#5c616c"
theme[available_mid]="#{{colors.primary.default.hex_stripped}}"
theme[available_end]="#f38ba8"
theme[used_start]="#5c616c"
theme[used_mid]="#{{colors.primary.default.hex_stripped}}"
theme[used_end]="#f38ba8"
theme[download_start]="#5c616c"
theme[download_mid]="#{{colors.primary.default.hex_stripped}}"
theme[download_end]="#f38ba8"
theme[upload_start]="#5c616c"
theme[upload_mid]="#{{colors.primary.default.hex_stripped}}"
theme[upload_end]="#f38ba8"
theme[process_start]="#5c616c"
theme[process_mid]="#{{colors.primary.default.hex_stripped}}"
theme[process_end]="#f38ba8"
