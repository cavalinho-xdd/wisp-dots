{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "constants": [
            "\u001b[38;2;{{colors.on_background.default.red}};{{colors.on_background.default.green}};{{colors.on_background.default.blue}}m",
            "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m"
        ]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "{$2}╭──────────────────────────────╮",
            "format": ""
        },
        {
            "type": "os",
            "key": "{$2}│ {$1}󰍹 OS  ",
            "format": "{$2}{name>20}{$2} │"
        },
        {
            "type": "kernel",
            "key": "{$2}│ {$1}󰌢 Ker ",
            "format": "{$2}{release>20}{$2} │"
        },
        {
            "type": "packages",
            "key": "{$2}│ {$1}󰏖 Pkg ",
            "format": "{$2}{all>20}{$2} │"
        },
        {
            "type": "wm",
            "key": "{$2}│ {$1}󰨇 WM  ",
            "format": "{$2}{2<12}{5<8}{$2} │"
        },
        {
            "type": "shell",
            "key": "{$2}│ {$1}󰆍 Sh  ",
            "format": "{$2}{3<12}{4<8}{$2} │"
        },
        {
            "type": "terminal",
            "key": "{$2}│ {$1}󰆍 Term",
            "format": "{$2}{3<20}{$2} │"
        },
        {
            "type": "uptime",
            "key": "{$2}│ {$1}󰅐 Up  ",
            "format": "{$2}{2>15}h {4}m{$2} │"
        },
        {
            "type": "memory",
            "key": "{$2}│ {$1}󰍛 Mem ",
            "format": "{$2}{1<9} /{2<9}{$2} │"
        },
        {
            "type": "custom",
            "key": "{$2}╰──────────────────────────────╯",
            "format": ""
        },
        "break"
    ]
}
